{
  "name": "vuoto",
  "version": "1.0.2",
  "private": false,
  "description": "Modern whitespace normalizer CLI with enhanced output and developer experience - cut the noise, clean the void",
  "keywords": [
    "whitespace",
    "normalizer",
    "unicode",
    "zero-width",
    "non-breaking-space",
    "cli",
    "formatter",
    "linter",
    "code-quality",
    "cleanup"
  ],
  "homepage": "https://github.com/dcdavidev/vuoto#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/vuoto/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dcdavidev/vuoto.git",
    "directory": "packages/vuoto"
  },
  "license": "MIT",
  "author": "Davide Di Criscito <info@dcdavidev.me>",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/command.d.ts",
      "import": "./dist/command.js",
      "default": "./dist/command.js"
    },
    "./consts": {
      "types": "./dist/consts.d.ts",
      "import": "./dist/consts.js",
      "default": "./dist/consts.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vuoto": "./dist/cli.js"
  },
  "files": [
    "assets",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage .turbo",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint:types": "tsc -p tsconfig.json",
    "test": "vitest run --no-fsModuleCache --passWithNoTests --coverage"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "cosmiconfig": "^10.0.1",
    "fast-glob": "^3.3.3",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
