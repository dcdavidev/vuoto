{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", "pnpm-lock.yaml", "tsconfig.base.json"],
  "globalPassThroughEnv": ["CI", "FORCE_COLOR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint:types": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tests/**",
        "vitest.config.*",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": ["coverage/**"]
    },
    "//#lint:code": {
      "inputs": ["$TURBO_DEFAULT$", "!**/dist/**", "!**/coverage/**"],
      "outputs": []
    },
    "//#lint:spelling": {
      "inputs": ["$TURBO_DEFAULT$", "!**/dist/**", "!**/coverage/**"],
      "outputs": []
    },
    "//#fmt:check": {
      "inputs": ["$TURBO_DEFAULT$", "!**/dist/**", "!**/coverage/**"],
      "outputs": []
    }
  }
}
