{
  "name": "root",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:conventional": "changeset-conventional",
    "check": "pnpm run lint && pnpm run spellcheck && pnpm run test",
    "check:ci": "pnpm run lint:check && pnpm run fmt:check && pnpm run spellcheck && pnpm run test",
    "commit": "cz",
    "commit:lint": "commitlint --from=HEAD~1",
    "fmt": "prettier --ignore-unknown --write .",
    "fmt:check": "prettier --ignore-unknown --check .",
    "lint": "eslint --no-warn-ignored --fix .",
    "lint:check": "eslint --no-warn-ignored .",
    "lint:fmt": "pnpm run lint && pnpm run fmt",
    "prepare": "lefthook install",
    "publish": "pnpm run version && pnpm run release",
    "release": "turbo run release",
    "spellcheck": "cspell --no-progress --no-summary .",
    "test": "turbo run test",
    "turbo:update": "pnpm dlx @turbo/codemod@latest update --force",
    "version": "changeset version"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@cspell/cspell-types": "^9.6.4",
    "@dcdavidev/tsconfig": "^0.1.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@release-it/conventional-changelog": "^10.0.5",
    "@spellbookx/recipes": "^1.0.0",
    "@turbo/gen": "^2.8.10",
    "changeset-conventional-commits": "^1.0.4",
    "commitizen": "^4.3.1",
    "commitlint-config-spellbookx": "^1.0.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cspell": "^9.6.4",
    "cspell-config-spellbookx": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-spellbookx": "^1.0.0",
    "lefthook": "^2.1.1",
    "prettier": "^3.8.1",
    "prettier-config-spellbookx": "^1.0.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-packagejson": "^3.0.0",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-properties": "^0.3.1",
    "prettier-plugin-sh": "^0.18.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prettier-plugin-toml": "^2.0.6",
    "release-it": "^19.2.4",
    "rolldown": "1.0.0-rc.5",
    "turbo": "^2.8.10",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=18"
  }
}
